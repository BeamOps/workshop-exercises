#!/usr/bin/env bash
# Validates: terraform-101 / act-3 / 08-state-drift
# The drill itself is watched live (the apply fails on a stale plan, then
# recovers). What we can check is that the CD pipeline is in place and the
# config is valid again after recovery.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && git rev-parse --show-toplevel)"
source "$ROOT/bin/lib.sh"

DIR="$ROOT/terraform-101/github-project"
WORKFLOW="$DIR/.github/workflows/terraform-cd.yml"

info "Checking your drift work (in github-project/)..."

check_msg "terraform is installed" \
  "install it or run 'mise install' in terraform-101/ (see 00-setup)" \
  command -v terraform

check_msg "the shared project exists (terraform-101/github-project/main.tf)" \
  "create terraform-101/github-project/main.tf and work there" \
  test -f "$DIR/main.tf"

check_msg "your CD pipeline is in place (from exercise 07)" \
  "you need the terraform-cd.yml workflow from exercise 07 to run this drill" \
  test -f "$WORKFLOW"

check_msg "terraform validate passes (config is clean after recovery)" \
  "recover from the drift: re-plan, then get a clean apply, until terraform validate passes" \
  terraform -chdir="$DIR" validate

finish
