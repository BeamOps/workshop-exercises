#!/usr/bin/env bash
# Validates: act-2-packaging-your-app/03-run-the-image
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && git rev-parse --show-toplevel)"
source "$ROOT/bin/lib.sh"

info "Checking your running container..."
require_docker

check_msg "the image starter-app:1.0 exists" \
  "build it in the previous exercise (02-first-dockerfile)" \
  image_exists starter-app:1.0

check_msg "a container named 'starter' is running" \
  "docker run -d --name starter -p 4000:4000 -e ... starter-app:1.0" \
  container_running starter

check_msg "'starter' publishes port 4000" \
  "publish the port with -p 4000:4000" \
  container_publishes starter 4000

check_msg "the app responds on http://localhost:4000" \
  "the container should be serving — check 'docker logs starter'" \
  http_ok http://localhost:4000

finish
