#!/usr/bin/env bash
# Validates: act-2-packaging-your-app/02-first-dockerfile
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && git rev-parse --show-toplevel)"
source "$ROOT/bin/lib.sh"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DF="$HERE/start/Dockerfile"

info "Checking your Dockerfile..."
require_docker

# Filled in (no ??? placeholders left).
check_msg "start/Dockerfile is filled in (no ??? left)" \
  "replace each ??? placeholder in start/Dockerfile" \
  bash -c "! grep -q '???' '$DF'"

# Deps copied before the source, so the deps layer stays cached (layer caching).
check_msg "deps are copied before the source (layer caching)" \
  "COPY mix.exs mix.lock ./ should come before the source copies" \
  grep -qE '^COPY[[:space:]]+mix\.exs[[:space:]]+mix\.lock' "$DF"

# Source is copied by naming dirs, never 'COPY . .'. Blindly copying everything drags
# the host's _build/ (a release built for the host OS) into the Linux image and the
# container dies with "Exec format error". This guards against that at build-authoring
# time; the boot check below proves it at runtime.
check_msg "source is copied explicitly, not with 'COPY . .'" \
  "copy only what the release needs (COPY config config, COPY lib lib, …), not COPY . ." \
  bash -c "! grep -qE '^COPY[[:space:]]+\.[[:space:]]+\.' '$DF'"

# Builds a release.
check_msg "the Dockerfile builds a release" \
  "add: RUN mix release" \
  grep -qE 'mix[[:space:]]+release' "$DF"

# CMD runs the release's server script by its FULL path. The build never runs CMD,
# so a wrong path (rel/app instead of rel/starter_app, or a relative path missing
# the _build/prod prefix) only fails at 'docker run' — this catches it here.
check_msg "CMD runs the release server (/app/_build/prod/rel/starter_app/bin/server)" \
  "CMD should run the full path: /app/_build/prod/rel/starter_app/bin/server" \
  grep -qE '^CMD.*_build/prod/rel/starter_app/bin/server' "$DF"

# The image actually built. We check the resulting image rather than running a
# (slow) build here — proof the Dockerfile is correct end to end.
check_msg "the image starter-app:1.0 built" \
  "docker build -f start/Dockerfile -t starter-app:1.0 ../../starter-app/starter_app" \
  image_exists starter-app:1.0

# The release actually boots inside the image. This is the real catch for a leaked
# host _build/: 'version' loads the release and its native code, so an image built
# from host artifacts fails here with "Exec format error" instead of surviving to
# bite you at 'docker run' in the next exercise.
check_msg "the release boots inside the image (no host _build leaked in)" \
  "rebuild after copying source explicitly; a host-built _build/ causes 'Exec format error'" \
  docker run --rm starter-app:1.0 /app/_build/prod/rel/starter_app/bin/starter_app version

finish
