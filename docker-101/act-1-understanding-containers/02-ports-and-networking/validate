#!/usr/bin/env bash
# Validates: act-1-understanding-containers/02-ports-and-networking
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && git rev-parse --show-toplevel)"
source "$ROOT/bin/lib.sh"

info "Checking your ports & networking work..."
require_docker

# Part 1 — ports (check the exercise's own containers publish the ports, so an
# unrelated process already on 4000 doesn't give a false pass)
check_msg "the 'app' container is published on port 4000" \
  "run nginx named app, publishing 4000" \
  container_publishes app 4000

check_msg "the 'app-2' container is published on port 4001" \
  "run a second container on a different host port" \
  container_publishes app-2 4001

# Part 2 — networking: prove name resolution actually works on the user-defined
# network by pinging 'db' by name from a throwaway container on it.
check_msg "the 'app-net' network exists" \
  "create a user-defined network" \
  network_exists app-net

check_msg "'db' is reachable by name on 'app-net'" \
  "run the database on app-net so containers there can resolve it by name" \
  can_reach app-net db

finish
