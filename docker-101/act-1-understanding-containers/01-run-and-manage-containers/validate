#!/usr/bin/env bash
# Validates: act-1 / 01-run-and-manage-containers
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && git rev-parse --show-toplevel)"
source "$ROOT/bin/lib.sh"

info "Checking your container lifecycle work..."
require_docker

check_msg "a container named 'db' exists" \
  "create it: docker run -d --name db -e POSTGRES_PASSWORD=postgres postgres:16" \
  container_exists db

check_msg "'db' is running" \
  "start it: docker start db" \
  container_running db

check_msg "'db' is based on the postgres image" \
  "it should be run from the 'postgres:16' image" \
  container_uses_image db postgres

check_msg "you stopped 'db' during the exercise" \
  "practice the lifecycle: docker stop db  (then docker start db)" \
  container_did db stop

check_msg "you opened a shell inside 'db'" \
  "try: docker exec -it db bash" \
  container_did db exec

finish
