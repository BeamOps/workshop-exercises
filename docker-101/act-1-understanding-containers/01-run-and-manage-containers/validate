#!/usr/bin/env bash
# Validates: act-1 / 01-run-and-manage-containers
#
# The exercise ends by removing the container, so we can't check end state.
# Instead we read Docker's event log to confirm each lifecycle step happened.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && git rev-parse --show-toplevel)"
source "$ROOT/bin/lib.sh"

info "Checking your container lifecycle work..."
require_docker

# Hints deliberately say WHAT is missing, not the command, figure that part out.
check_msg "you created a 'db' container" \
  "no 'db' container seen this session" \
  container_did db create

check_msg "you stopped 'db'" \
  "'db' was never stopped" \
  container_did db stop

check_msg "you opened a shell inside 'db'" \
  "you haven't opened a shell in 'db'" \
  container_did db exec

check_msg "you removed 'db'" \
  "'db' still exists — the lifecycle isn't finished" \
  container_did db destroy

finish
