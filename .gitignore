# Elixir / Phoenix build artifacts (exercises contain Phoenix app copies)
/**/_build/
/**/deps/
/**/*.ez
/**/erl_crash.dump
*.beam

# Attendee-generated starter app (Act 2/3). Generated in 00-setup, reused across
# acts, never committed — only starter-app/README.md is tracked.
/docker-101/starter-app/starter_app/

# Node / assets
/**/node_modules/
/**/priv/static/assets/

# Secrets and local env
.env
.env.*
!.env.example

# Exercise-created data dirs (e.g. Postgres bind mounts)
pgdata/
**/pgdata/

# Terraform working files (exercises generate these locally, never commit)
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files can hold secrets (e.g. the GitHub token)
*.tfvars
*.tfvars.json
!*.tfvars.example

# The shared, evolving Terraform project (attendee's local main.tf + state, not committed)
terraform-101/github-project/*
!terraform-101/github-project/README.md

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/
